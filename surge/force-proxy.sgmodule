#!name=Grok Bot 强制走代理
#!desc=Grok Bot.app 以及 grok.com / x.ai 强制走 PROXY，不开全局。PROXY 必须是真实出国策略。
#!category=分流
#!homepage=https://github.com/iwen-conf/force-proxy-override

[Rule]
AND,((DOMAIN-SUFFIX,grok.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,x.ai),(PROTOCOL,UDP),(DST-PORT,443)),REJECT
PROCESS-NAME,Grok Bot,PROXY
PROCESS-NAME,Grok Bot Helper,PROXY
DOMAIN-SUFFIX,grok.com,PROXY
DOMAIN-SUFFIX,grokusercontent.com,PROXY
DOMAIN-SUFFIX,grokipedia.com,PROXY
DOMAIN-SUFFIX,x.ai,PROXY
DOMAIN-SUFFIX,spacex.ai,PROXY
